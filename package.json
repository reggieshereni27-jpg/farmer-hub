{
  "name": "farmer-hub",
  "version": "1.0.0",
  "description": "Comprehensive farming application for crop management, weather, market prices, equipment rental, advisory, and supply chain",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "build": "webpack --mode production",
    "frontend:dev": "cd frontend/web && npm run dev",
    "backend:dev": "nodemon backend/server.js"
  },
  "keywords": [
    "farming",
    "agriculture",
    "crop management",
    "weather",
    "market prices",
    "equipment rental"
  ],
  "author": "Farmer Hub Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "redis": "^4.6.7",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "axios": "^1.4.0",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "express-validator": "^7.0.0",
    "socket.io": "^4.7.1",
    "mqtt": "^5.0.0",
    "sequelize": "^6.32.2",
    "winston": "^3.10.0",
    "joi": "^17.10.0",
    "stripe": "^12.16.0",
    "nodemailer": "^6.9.4",
    "aws-sdk": "^2.1418.0",
    "ml-api-sdk": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "eslint": "^8.47.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.0",
    "prettier": "^3.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "knex": "^2.5.1",
    "@types/node": "^20.4.5"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
