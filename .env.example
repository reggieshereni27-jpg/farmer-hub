# Environment Configuration

# Application
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
APP_SECRET=your_secret_key_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmer_hub
DB_USER=farmer_user
DB_PASSWORD=secure_password
DB_SSL=false

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# Email Service
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@farmerhub.com

# Weather API
WEATHER_API_KEY=your_weather_api_key
WEATHER_API_URL=https://api.openweathermap.org

# Market Price API
MARKET_API_KEY=your_market_api_key
MARKET_API_URL=https://api.commodity-prices.com

# Payment Gateway
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# AWS S3 (File Storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=farmer-hub-storage

# SMS Service
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn
GOOGLE_ANALYTICS_ID=your_ga_id

# AI/ML Services
ML_API_KEY=your_ml_api_key
ML_API_URL=https://api.ml-service.com

# IoT Sensor Integration
IOT_BROKER_URL=mqtt://broker.hivemq.com
IOT_TOPIC_PREFIX=farmerhub

# Social Media Integration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

# Maps & Geolocation
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# Development Tools
DEBUG=farmer-hub:*
